# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
# development | test | production
# production requires at least one MODERATION_API_KEY(S) and (for ollama.com) at least one Ollama key
APP_ENV=development

# --- Ollama backend ---
# Default: Ollama Cloud SaaS. For self-hosted use e.g. http://127.0.0.1:11434
# (from Docker Compose to host Ollama, often http://host.docker.internal:11434).
# Do NOT use ollama.com/library/... page URLs as the API base.
OLLAMA_BASE_URL=https://ollama.com

# Multi-key pool (comma-separated). Preferred for Cloud; round-robin with cooldown on 401/403/429.
OLLAMA_API_KEYS=
# Legacy single key (still supported; merged into the pool). Self-hosted usually needs neither.
OLLAMA_API_KEY=

# --- Gateway auth ---
# Clients send: Authorization: Bearer <one of these values>
# Required when APP_ENV=production. Leave empty only for local smoke tests.
# Multi-key list (comma-separated). Preferred when multiple clients need their own key.
MODERATION_API_KEYS=
# Legacy single key (still supported; merged into the accepted key list).
MODERATION_API_KEY=change-me

# --- Model aliases (client name → Ollama native) ---
DEFAULT_MODERATION_MODEL=moderation-fast
MODEL_GPT_OSS_20B=gpt-oss:20b
MODEL_GEMMA4_31B=gemma4:31b
MODEL_GPT_OSS_120B=gpt-oss:120b

# --- Timeouts & limits ---
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=190
MAX_INPUT_CHARS=16000
MAX_BATCH_SIZE=32
MAX_CONCURRENCY=2
OLLAMA_KEEP_ALIVE=10m
# Seconds a key stays out of rotation after 401/403/429/quota errors
KEY_COOLDOWN_SECONDS=30

# --- Sampling (passed through to Ollama chat) ---
TEMPERATURE=0.2
TOP_P=0.95
TOP_K=64
THINKING=false

# --- Policy ---
# flag | allow | error — what to do when scores sit near thresholds
UNCERTAIN_MODE=flag
POLICY_PATH=configs/policy.yaml
POLICY_VERSION=v1
PROMPT_VERSION=v1

# --- Feature flags ---
ALLOW_IMAGE_INPUT=false
EXPOSE_BACKEND_METADATA=false
EXPOSE_NATIVE_MODELS=false
INCLUDE_APPLIED_INPUT_TYPES=true
ENABLE_DOCS=true
LOG_LEVEL=INFO
# Keep false in production — raw user text in logs is high risk
LOG_RAW_INPUT=false
ENABLE_FALLBACK=false
FALLBACK_MODEL=
# Comma-separated origins; empty disables CORS
CORS_ORIGINS=
