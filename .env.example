APP_HOST=0.0.0.0
APP_PORT=8000
# development | test | production
APP_ENV=development

# Default: Ollama Cloud SaaS. Override for self-hosted (e.g. http://127.0.0.1:11434).
# Do NOT use ollama.com/library/... page URLs.
OLLAMA_BASE_URL=https://ollama.com

# Multi-key pool (comma-separated). Preferred for Cloud.
OLLAMA_API_KEYS=
# Legacy single key (still supported; merged into the pool)
OLLAMA_API_KEY=

# Gateway auth — required in production
MODERATION_API_KEY=change-me

DEFAULT_MODERATION_MODEL=moderation-fast
MODEL_GPT_OSS_20B=gpt-oss:20b
MODEL_GEMMA4_31B=gemma4:31b
MODEL_GPT_OSS_120B=gpt-oss:120b

OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=190
MAX_INPUT_CHARS=16000
MAX_BATCH_SIZE=32
MAX_CONCURRENCY=2
OLLAMA_KEEP_ALIVE=10m
KEY_COOLDOWN_SECONDS=30

TEMPERATURE=0.2
TOP_P=0.95
TOP_K=64
THINKING=false

# flag | allow | error
UNCERTAIN_MODE=flag
POLICY_PATH=configs/policy.yaml
POLICY_VERSION=v1
PROMPT_VERSION=v1

ALLOW_IMAGE_INPUT=false
EXPOSE_BACKEND_METADATA=false
EXPOSE_NATIVE_MODELS=false
INCLUDE_APPLIED_INPUT_TYPES=true
ENABLE_DOCS=true
LOG_LEVEL=INFO
LOG_RAW_INPUT=false
ENABLE_FALLBACK=false
FALLBACK_MODEL=
CORS_ORIGINS=
